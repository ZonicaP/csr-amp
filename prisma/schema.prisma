generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  ACTIVE
  OVERDUE
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model User {
  id              String        @id @default(cuid())
  membershipId    String        @unique
  firstName       String
  lastName        String
  email           String        @unique
  phone           String?
  phoneDigits     String        @default(dbgenerated("regexp_replace(COALESCE(\"phone\", ''), '[^0-9]', '', 'g')"))
  membershipIdKey String        @default(dbgenerated("regexp_replace(upper(\"membershipId\"), '[^A-Z0-9]', '', 'g')"))
  status          AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  vehicles  Vehicle[]
  purchases Purchase[]
  events    CustomerEvent[]
  calls     Call[]

  @@index([lastName, firstName])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_lastName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_phone_trgm_idx")
  @@index([phoneDigits(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_phoneDigits_trgm_idx")
  @@index([membershipId(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_membershipId_trgm_idx")
  @@index([membershipIdKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_membershipIdKey_trgm_idx")
}

model Vehicle {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  licensePlate  String?
  make          String?
  model         String?
  year          Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  purchases     Purchase[]

  @@index([userId, createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  vehicleId String
  vehicle   Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  planName  String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([vehicleId, startedAt])
}

model Purchase {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description   String
  amount        Decimal   @db.Decimal(10, 2)
  failureReason String?
  purchasedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([vehicleId])
  @@index([userId, purchasedAt])
}

enum CustomerEventType {
  ACCOUNT_OPENED
  PLAN_STARTED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ACCOUNT_OVERDUE
  PLAN_CANCELLED
  ACCOUNT_CANCELLED
  ACCOUNT_UPDATED
}

model CustomerEvent {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrId     String?
  csr       Csr?              @relation(fields: [csrId], references: [id], onDelete: SetNull)
  callId    String?
  call      Call?             @relation(fields: [callId], references: [id], onDelete: SetNull)
  type      CustomerEventType
  summary   String
  createdAt DateTime

  @@index([userId, createdAt])
  @@index([callId])
  @@index([csrId])
}

enum CallStatus {
  OPEN
  CLOSED
  CALLBACK
}

model Call {
  id                   String          @id @default(cuid())
  reference            String          @unique
  csrId                String
  csr                  Csr             @relation("CallCsr", fields: [csrId], references: [id], onDelete: Restrict)
  status               CallStatus      @default(OPEN)
  startedAt            DateTime        @default(now())
  endedAt              DateTime?
  gaveReference        Boolean         @default(false)
  confirmedNothingElse Boolean         @default(false)
  closingNotes         String?
  callbackNote         String?
  resolvedAt           DateTime?
  escalatedAt          DateTime?
  escalatedFromCsrId   String?
  escalatedFrom        Csr?            @relation("CallEscalatedFrom", fields: [escalatedFromCsrId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  events               CustomerEvent[]

  @@index([csrId, status])
  @@index([startedAt])
  @@index([escalatedFromCsrId])
  @@index([userId])
}

enum CsrStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CsrRoleName {
  ADMIN
  AGENT
}

model Csr {
  id              String     @id @default(cuid())
  name            String
  surname         String
  email           String     @unique
  displayName     String
  status          CsrStatus  @default(INVITED)
  passwordHash           String?
  inviteTokenHash        String?   @unique
  passwordResetTokenHash     String?   @unique
  passwordResetExpiresAt     DateTime?
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  roles           CsrRole[]
  calls           Call[] @relation("CallCsr")
  escalatedCalls  Call[] @relation("CallEscalatedFrom")
  events          CustomerEvent[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model CsrRole {
  csrId String
  csr   Csr         @relation(fields: [csrId], references: [id], onDelete: Cascade)
  role  CsrRoleName

  @@id([csrId, role])
}

model RateLimitBucket {
  key       String   @id
  hits      Json
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
